# ─── Telegram UserBot (GramJS) ──────────────────────────────────────────────
TG_API_ID=36486488
TG_API_HASH=d849da7b9bf4161a59b78ea1b380fcae
# npm run login — ishlatib oling, chiqadigan stringni shu yerga qo'ying:
TG_SESSION=

# ─── Telegram Bot (grammY) ──────────────────────────────────────────────────
# @BotFather dan oling: /newbot → token
BOT_TOKEN=8317092938:AAEnu2QEaIB8ztyVJiFOfO-qy3LUt9ax7YQ

# ─── Owner & Channel ────────────────────────────────────────────────────────
MY_CHAT_ID=8709409829
CHANNEL_USERNAME=@undefined_codes

# ─── Google Gemini ──────────────────────────────────────────────────────────
# ⚠️ Chatda ulashilgan kalitni REVOKE qilib, YANGI kalit yarating:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ.Ab8RN6IsZO8M0lFDZBlXUZb0Ct8v7bAvjYf_qp582y3NptNLHw
GEMINI_MODEL=gemini-2.5-flash

# ─── Source Chats ────────────────────────────────────────────────────────────
# Virgul bilan ajrating, @ belgisisiz. Misol: techcrunchrus,hackernews_uz
SOURCE_CHATS=

# ─── Blog Pipeline ─────────────────────────────────────────────────────────
BLOG_ENABLED=true

# ─── Scheduler ──────────────────────────────────────────────────────────────
CRON_EXPR="0 20 * * 1,3,5"
TIMEZONE=Asia/Tashkent

# ─── Personal Digest Agent ──────────────────────────────────────────────────
# Har kuni 21:00 da egasining shaxsiy chatiga hisobot yuborish
DIGEST_CRON="0 21 * * *"
# Maksimal necha kun oldingi xabarlarni tahlil qilish
DIGEST_MAX_DAYS=3
# Shaxsiy (private user) yozishmalarni tahlilga qo'shish (true|false)
DIGEST_INCLUDE_PRIVATE=true
# Tahlildan butunlay chiqarib tashlanadigan chatlar (username, sarlavha yoki raqamli ID, vergul bilan)
EXCLUDE_CHATS=
# Tahlil qilinadigan maksimal dialoglar soni
MAX_DIALOGS=80
# Kanal va guruhlardan siz uchun muhim deb ajratiladigan qiziqishlar ro'yxati
USER_INTERESTS="React, Next.js, TypeScript, React Native, frontend vakansiyalar, junior/intern imkoniyatlari, hackathon, grant, bepul kurslar, yangi texnologiyalar"

# ─── Topic Categories & Weights ─────────────────────────────────────────────
# Mavzular va ularning vaznlari (nisbiy foizlarda, vergul bilan id:vazn)
# Standart: it:50, karyera:15, imkoniyatlar:15, oqish:10, fan:10
TOPIC_WEIGHTS="it:50,karyera:15,imkoniyatlar:15,oqish:10,fan:10"

# Standart holatda o'chirilgan mavzularni yoqish (masalan: pul)
# Virgul bilan ajrating. Misol: pul
ENABLE_TOPICS=

# Har bir kategoriya uchun ixtiyoriy alohida RSS tasmalari (vergul bilan ajratilgan URLlar)
# Bo'sh qoldirilsa faqat Google Search grounding ishlatiladi
RSS_FEEDS_KARYERA=
RSS_FEEDS_IMKONIYATLAR=
RSS_FEEDS_OQISH=
RSS_FEEDS_FAN=

# ─── Growth Module ──────────────────────────────────────────────────────────
# Har bir post chiqqandan so'ng LinkedIn, Reels/Shorts ssenariy va karusel yaratish (true|false)
GROWTH_PACK=true
# Tarqatish paketi tili (uz | en)
GROWTH_LANG=uz
# Har nechanchi postga lead magnit havolasini avtomatik qo'shish
PROMO_EVERY=3

# ─── Optional ────────────────────────────────────────────────────────────────
LOOKBACK_DAYS=3
MAX_REWRITES=5
DB_PATH=./data/agent.db
EXPORTS_DIR=./data/exports
RSS_FEEDS=


