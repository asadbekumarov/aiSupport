{
  "name": "it-content-agent",
  "version": "1.0.0",
  "description": "IT Content Creator & News Digest Agent for Telegram",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning index.js",
    "login": "node --disable-warning=ExperimentalWarning scripts/login.js",
    "test:all": "node scripts/test-all.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ai-support-bot",
    "pm2:restart": "pm2 restart ai-support-bot",
    "pm2:logs": "pm2 logs ai-support-bot"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.0.0",
    "grammy": "^1.30.0",
    "node-cron": "^3.0.0",
    "rss-parser": "^3.13.0",
    "telegram": "^2.26.0"
  }
}
